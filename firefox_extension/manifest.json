{
  "manifest_version": 3,
  "name": "I-DS Download Support",
  "version": "1.3",
  "description": "Media detection and right-click downloads with I-DS by InShaLIve.os",
  "icons": { "16": "icons/i-ds-16.png", "32": "icons/i-ds-32.png", "48": "icons/i-ds-48.png", "128": "icons/i-ds-128.png" },
  "action": { "default_title": "I-DS Browser Settings", "default_icon": { "16": "icons/i-ds-16.png", "32": "icons/i-ds-32.png" } },
  "permissions": ["contextMenus", "activeTab", "storage", "webRequest"],
  "host_permissions": ["http://127.0.0.1:18765/*", "http://*/*", "https://*/*"],
  "background": {
    "scripts": ["media_candidates.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media_candidates.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stratrum-download-studio@stratrum.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
