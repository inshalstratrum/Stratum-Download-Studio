{
  "manifest_version": 3,
  "name": "Stratum Download Studio",
  "version": "1.2",
  "description": "Adds user-controlled media detection and right-click downloads for Stratum Download Studio",
  "permissions": ["contextMenus", "activeTab", "storage", "webRequest"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media_candidates.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
