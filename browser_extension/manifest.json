{
  "manifest_version": 3,
  "name": "Stratrum Download Studio",
  "version": "1.0",
  "description": "Adds right-click download option for Stratrum Download Studio",
  "permissions": ["contextMenus", "activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
