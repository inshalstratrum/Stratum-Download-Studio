{
  "manifest_version": 3,
  "name": "IDM Clone Auto-Grabber",
  "version": "1.0",
  "description": "Adds right-click download option and video grab button for IDM Clone",
  "permissions": ["contextMenus", "activeTab"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
